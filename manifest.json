  "edge_side_panel": {
    "preferred_width": 480
  },
  
  "file_handlers": [
    {
      "action": "/index.html",
      "accept": {
        "text/html": [".html", ".htm"]
      }
    }
  ],
  
  "handle_links": "preferred",
  
  "launch_handler": {
    "client_mode": "auto"
  },
  
  "permissions": [
    "clipboard-write"
  ],
  
  "prefer_related_applications": false,
  "related_applications": [],
  
  "protocol_handlers": [
    {
      "protocol": "web+antisocial",
      "url": "/index.html?url=%s"
    }
  ],
  
  "register_protocol_handler": true,
  
  "share_target": {
    "action": "/index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  
  "iarc_rating_id": "e84b072d-71b3-4d3e-86e0-7c1d2d6143a8",
  
  "id": "/",
  "scope_extensions": [],
  
  "serviceworker": {
    "src": "/sw.js",
    "scope": "/",
    "type": "classic",
    "update_via_cache": "all"
  },
  
  "widgets": [
